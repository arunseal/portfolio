    "@next/bundle-analyzer": "^13.1.6",
    "@tabler/icons-react": "^2.4.0",
    "@vercel/analytics": "^1.2.2",
    "gray-matter": "^4.0.3",
    "next": "^16.3.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
